rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Booking Passes Storage Rules
    match /booking-passes/{bookingId}/{passFile} {
      // Anyone with the pass URL can view and download their PNG pass
      allow read: if true;
      
      // Writes are restricted to authenticated admins or server
      allow write: if request.auth != null;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
